@using Sudoku.Core
@using Sudoku.Core.Models
@using Sudoku.Core.Services
@using Microsoft.JSInterop

@if (Game.Board.Kind == PuzzleKind.Star)
{
    <div class="shape-stage">
        <div class="shape-frame" @ref="_stage" role="grid" aria-label="Астра" @onpointerdown="OnStageClick">
            @for (var i = 0; i < Game.Board.CellCount; i++)
            {
                var cell = i;
                var (ring, sector) = AstraLayout.Coords(cell);
                var clip = AstraLayout.CssClip(ring, sector);
                var (lx, ly) = AstraLayout.CssCenter(ring, sector);
                <div class="@AstraClass(cell, ring, sector)" style="-webkit-clip-path: @clip; clip-path: @clip"></div>
                @if (Game.Current[cell] != 0)
                {
                    <span class="@AstraTextClass(cell)" style="left: @Pct(lx); top: @Pct(ly)">@DigitSymbols.Of(Game.Current[cell])</span>
                }
                else if (Game.Notes[cell] != 0)
                {
                    <span class="anotes" style="left: @Pct(lx); top: @Pct(ly)">@AstraNotes(cell)</span>
                }
            }
        </div>
    </div>
}
else if (Game.Board.Kind == PuzzleKind.Hoshi)
{
    <div class="shape-stage">
        <div class="shape-frame" @ref="_stage" role="grid" aria-label="Звезда" @onpointerdown="OnStageClick">
            <div class="hoshi-hole" style="-webkit-clip-path: @HoshiLayout.CssHole(); clip-path: @HoshiLayout.CssHole()"></div>
            @for (var s = 0; s < HoshiLayout.Sectors; s++)
            {
                var outline = HoshiLayout.CssSector(s);
                <div class="hoshi-outline" style="-webkit-clip-path: @outline; clip-path: @outline"></div>
            }
            @for (var i = 0; i < Game.Board.CellCount; i++)
            {
                var cell = i;
                var clip = HoshiLayout.CssClip(cell);
                var (lx, ly) = HoshiLayout.CssCenter(cell);
                <div class="@HoshiClass(cell)" style="-webkit-clip-path: @clip; clip-path: @clip"></div>
                @if (Game.Current[cell] != 0)
                {
                    <span class="@HoshiTextClass(cell)" style="left: @Pct(lx); top: @Pct(ly)">@DigitSymbols.Of(Game.Current[cell])</span>
                }
                else if (Game.Notes[cell] != 0)
                {
                    <span class="hnotes" style="left: @Pct(lx); top: @Pct(ly)">@AstraNotes(cell)</span>
                }
            }
        </div>
    </div>
}
else
{
    <div class="board" style="--n: @Game.Board.Size" role="grid" aria-label="Поле судоку">
        @for (var i = 0; i < Game.Board.CellCount; i++)
        {
            var cell = i;
            var (row, col) = Game.Board.Coords(cell);
            var region = Game.Board.RegionOfCell[cell];
            <button type="button"
                    class="@CellClass(cell, row, col, region)"
                    role="gridcell"
                    @onclick="() => Select(cell)">
                @if (CageSumAt(cell) is { } sum)
                {
                    <span class="cage-sum">@sum</span>
                }
                @if (Game.Current[cell] != 0)
                {
                    <span class="val">@DigitSymbols.Of(Game.Current[cell])</span>
                }
                else if (Game.Notes[cell] != 0)
                {
                    <span class="notes" style="--notes: @(Game.Board.Size <= 9 ? 3 : 4)">
                        @for (var v = 1; v <= Game.Board.Size; v++)
                        {
                            <span>@((Game.Notes[cell] & (1UL << v)) != 0 ? DigitSymbols.Of(v) : "")</span>
                        }
                    </span>
                }
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public SudokuGame Game { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _stage;
    private HashSet<int> _conflicts = [];

    protected override void OnParametersSet()
    {
        _conflicts = Game.Conflicts().ToHashSet();
    }

    private async Task OnStageClick(PointerEventArgs e)
    {
        double[]? n = null;
        try
        {
            n = await JS.InvokeAsync<double[]>("sudokuShape.norm", _stage, e.ClientX, e.ClientY);
        }
        catch
        {
            // без JS нельзя надёжно перевести пиксели в клетку
        }

        if (n is not { Length: 2 })
            return;

        var cell = Game.Board.Kind == PuzzleKind.Star
            ? AstraLayout.HitTest(n[0], n[1])
            : HoshiLayout.HitTest(n[0], n[1]);
        if (cell >= 0)
            await Select(cell);
    }

    private async Task Select(int cell)
    {
        Game.Selected = cell;
        await OnChanged.InvokeAsync();
    }

    private static string Pct(double value) => ShapeGeom.Pct(value);

    private string AstraClass(int cell, int ring, int sector)
    {
        var cls = $"acell chk{(ring + sector) & 1}";
        if (cell == Game.Selected) cls += " selected";
        if (Game.IsGiven(cell)) cls += " given";
        if (Game.SameValueAsSelected(cell)) cls += " same";
        if (_conflicts.Contains(cell)) cls += " conflict";
        if (Game.ShowMistakes && Game.Current[cell] != 0 && Game.Current[cell] != Game.Solution[cell]) cls += " wrong";
        return cls;
    }

    private string AstraTextClass(int cell)
    {
        var cls = "aval";
        if (Game.IsGiven(cell)) cls += " given";
        if (Game.SameValueAsSelected(cell)) cls += " same";
        if (_conflicts.Contains(cell)) cls += " conflict";
        if (Game.ShowMistakes && Game.Current[cell] != 0 && Game.Current[cell] != Game.Solution[cell]) cls += " wrong";
        return cls;
    }

    private string AstraNotes(int cell)
    {
        var parts = new List<string>(7);
        for (var v = 1; v <= Game.Board.Size; v++)
        {
            if ((Game.Notes[cell] & (1UL << v)) != 0)
                parts.Add(DigitSymbols.Of(v));
        }
        return string.Join(" ", parts);
    }

    private string HoshiClass(int cell)
    {
        var cls = $"hcell hs{HoshiLayout.Sector(cell)}";
        if (cell == Game.Selected) cls += " selected";
        if (Game.IsGiven(cell)) cls += " given";
        if (Game.SameValueAsSelected(cell)) cls += " same";
        if (_conflicts.Contains(cell)) cls += " conflict";
        if (Game.ShowMistakes && Game.Current[cell] != 0 && Game.Current[cell] != Game.Solution[cell]) cls += " wrong";
        return cls;
    }

    private string HoshiTextClass(int cell)
    {
        var cls = "hval";
        if (Game.IsGiven(cell)) cls += " given";
        if (Game.SameValueAsSelected(cell)) cls += " same";
        if (_conflicts.Contains(cell)) cls += " conflict";
        if (Game.ShowMistakes && Game.Current[cell] != 0 && Game.Current[cell] != Game.Solution[cell]) cls += " wrong";
        return cls;
    }

    private string CellClass(int cell, int row, int col, int region)
    {
        var size = Game.Board.Size;
        var cls = $"cell r{region % 9}";
        if (cell == Game.Selected) cls += " selected";
        if (Game.IsGiven(cell)) cls += " given";
        if (Game.IsPeer(cell)) cls += " peer";
        if (Game.SameValueAsSelected(cell)) cls += " same";
        if (Game.Board.Kind == PuzzleKind.Diagonal)
        {
            if (row == col) cls += " diag diag-main";
            if (row + col == size - 1) cls += " diag diag-anti";
            if (row == col && row + col == size - 1) cls += " diag-both";
        }
        if (_conflicts.Contains(cell)) cls += " conflict";
        if (Game.ShowMistakes && Game.Current[cell] != 0 && Game.Current[cell] != Game.Solution[cell]) cls += " wrong";

        if (row == 0 || RegionAt(row - 1, col) != region) cls += " edge-n";
        if (col == 0 || RegionAt(row, col - 1) != region) cls += " edge-w";
        if (row == size - 1 || RegionAt(row + 1, col) != region) cls += " edge-s";
        if (col == size - 1 || RegionAt(row, col + 1) != region) cls += " edge-e";

        if (Game.Board.BoxWidth > 0)
        {
            if (col % Game.Board.BoxWidth == 0) cls += " box-w";
            if (row % Game.Board.BoxHeight == 0) cls += " box-n";
        }

        if (Game.Board.Cages.Count > 0)
        {
            var cage = CageIdAt(row, col);
            if (row == 0 || CageIdAt(row - 1, col) != cage) cls += " cage-n";
            if (col == 0 || CageIdAt(row, col - 1) != cage) cls += " cage-w";
            if (row == size - 1 || CageIdAt(row + 1, col) != cage) cls += " cage-s";
            if (col == size - 1 || CageIdAt(row, col + 1) != cage) cls += " cage-e";
        }

        return cls;
    }

    private int? CageSumAt(int cell)
    {
        if (Game.Board.Cages.Count == 0 || Game.Board.CageId.Length <= cell)
            return null;
        var cage = Game.Board.Cages[Game.Board.CageId[cell]];
        return cage.Anchor == cell ? cage.Sum : null;
    }

    private int CageIdAt(int row, int col)
    {
        if (row < 0 || col < 0 || row >= Game.Board.Size || col >= Game.Board.Size)
            return -1;
        var cell = Game.Board.Index(row, col);
        return Game.Board.CageId.Length > cell ? Game.Board.CageId[cell] : -1;
    }

    private int RegionAt(int row, int col)
    {
        if (row < 0 || col < 0 || row >= Game.Board.Size || col >= Game.Board.Size)
            return -1;
        return Game.Board.RegionOfCell[Game.Board.Index(row, col)];
    }
}
